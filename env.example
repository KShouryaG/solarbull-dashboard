# SolarBull Energy Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# Variables marked REQUIRED will cause a RuntimeError at startup if not set.

# ─── iSolarCloud API ──────────────────────────────────────────────────────────
# REQUIRED: Your iSolarCloud login credentials
SUNGROW_USERNAME=your_isolarcloud_username
SUNGROW_PASSWORD=your_isolarcloud_password

# REQUIRED: App Key & Secret from Sungrow Developer Portal
# Get these at https://developer-api.isolarcloud.com/
SUNGROW_APPKEY=your_app_key_here
SUNGROW_APPSECRET=your_app_secret_here

# OPTIONAL: API server — use international for India
SUNGROW_SERVER=https://gateway.isolarcloud.com.hk
# SUNGROW_SERVER=https://gateway.isolarcloud.com       # China
# SUNGROW_SERVER=https://gateway.isolarcloud.eu         # Europe
# SUNGROW_SERVER=https://augateway.isolarcloud.com      # Australia

# ─── Auth & Security ─────────────────────────────────────────────────────────
# REQUIRED: Long random string — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# REQUIRED: Admin dashboard credentials
ADMIN_PASSWORD=your_admin_password
ADMIN_EMAIL=your@email.com

# OPTIONAL: Admin display name and username (defaults shown)
ADMIN_USERNAME=shourya
ADMIN_NAME=Shourya Gupta

# OPTIONAL: JWT token expiry in hours (default 24)
JWT_EXPIRY_HOURS=24

# ─── CORS ────────────────────────────────────────────────────────────────────
# OPTIONAL: Comma-separated allowed frontend origins
# Add your Vercel domain for production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# ─── Server ──────────────────────────────────────────────────────────────────
# OPTIONAL: Port (default 8080)
PORT=8080

# OPTIONAL: Cache TTL in seconds (default 600)
CACHE_TTL=300

# OPTIONAL: Set to true to use randomised demo data without iSolarCloud
USE_DEMO=false

# ─── Solar KPIs ──────────────────────────────────────────────────────────────
# OPTIONAL: Used for performance ratio and revenue estimates
PEAK_SUN_HOURS=5.5
TARIFF_PER_KWH=4.5
CO2_KG_PER_KWH=0.82

# ─── AI Chatbot ──────────────────────────────────────────────────────────────
# OPTIONAL: Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
