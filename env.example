# SolarBull Energy Dashboard - Sungrow iSolarCloud Config
# Fill in your actual credentials below

# iSolarCloud Login (same as the app/web portal)
SUNGROW_USERNAME=your_isolarcloud_username
SUNGROW_PASSWORD=your_isolarcloud_password

# App Key & Secret (from Sungrow Developer Portal)
# Get these by creating an app at https://developer-api.isolarcloud.com/
SUNGROW_APPKEY=your_app_key_here
SUNGROW_APPSECRET=your_app_secret_here

# Server URL - for India, use "international"
SUNGROW_SERVER=https://gateway.isolarcloud.com.hk
# Other regions:
# SUNGROW_SERVER=https://gateway.isolarcloud.com       # China
# SUNGROW_SERVER=https://gateway.isolarcloud.eu         # Europe
# SUNGROW_SERVER=https://augateway.isolarcloud.com      # Australia

# Server Settings
PORT=8080
CACHE_TTL=300

# Set to true to use demo data without real credentials
USE_DEMO=false
